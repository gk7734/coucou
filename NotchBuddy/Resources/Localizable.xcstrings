    "chat.other-providers.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لاستخدام Google Gemini أو OpenAI من الدردشة. تُحفظ المفاتيح في Keychain."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "চ্যাট থেকে Google Gemini বা OpenAI ব্যবহার করতে। কীগুলো Keychain-এ সংরক্ষিত হয়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To use Google Gemini or OpenAI from the chat. Keys are stored in the Keychain."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para usar Google Gemini u OpenAI desde el chat. Las claves se guardan en el Keychain."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour utiliser Google Gemini ou OpenAI depuis le chat. Les clés sont stockées dans le Trousseau."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चैट से Google Gemini या OpenAI उपयोग करने के लिए। कुंजियां Keychain में संग्रहीत की जाती हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk menggunakan Google Gemini atau OpenAI dari chat. Kunci disimpan di Keychain."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "채팅에서 Google Gemini나 OpenAI를 쓰려면 입력하세요. 키는 키체인에 저장됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para usar o Google Gemini ou OpenAI pelo chat. As chaves são armazenadas no Keychain."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для использования Google Gemini или OpenAI в чате. Ключи хранятся в Keychain."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于在聊天中使用 Google Gemini 或 OpenAI。密钥存储在 Keychain 中。"
          }
        }
      }
    },
