    "While Apple Music, Spotify or TIDAL plays, its pill shows and Mochi dances, without adding the pill to Active pills.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أثناء تشغيل Apple Music أو Spotify أو TIDAL تظهر حبّته ويرقص Mochi، دون إضافتها إلى الحبوب النشطة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Music, Spotify বা TIDAL বাজলে তার পিল দেখা যায় আর Mochi নাচে, সক্রিয় পিলে যোগ না করেই।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While Apple Music, Spotify or TIDAL plays, its pill shows and Mochi dances, without adding the pill to Active pills."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras suena Apple Music, Spotify o TIDAL, su píldora aparece y Mochi baila, sin añadirla a las píldoras activas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand Apple Music, Spotify ou TIDAL joue, sa pastille apparaît et Mochi danse, sans l'ajouter aux pastilles actives."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Music, Spotify या TIDAL चलते समय उसकी पिल दिखती है और Mochi नाचता है, उसे सक्रिय पिल में जोड़े बिना।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat Apple Music, Spotify, atau TIDAL diputar, pil-nya muncul dan Mochi menari, tanpa menambahkannya ke pil aktif."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Music, Spotify, TIDAL이 재생되는 동안 활성 필에 추가하지 않아도 그 필이 나타나고 Mochi가 춤춥니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enquanto Apple Music, Spotify ou TIDAL toca, a pílula dele aparece e o Mochi dança, sem adicioná-la às pílulas ativas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока играет Apple Music, Spotify или TIDAL, появляется его плашка и Mochi танцует — без добавления в активные плашки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Music、Spotify 或 TIDAL 播放时，会显示其标签且 Mochi 会跳舞，无需加入活动标签。"
          }
        }
      }
    },
