    "plugin.hermes.approvals": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عرض طلبات الموافقة في الشريط"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নচে অনুমোদন অনুরোধ দেখান"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show approval requests in the notch"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar solicitudes de aprobación en el notch"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher les demandes d'approbation dans le notch"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नॉच में अनुमोदन अनुरोध दिखाएं"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampilkan permintaan persetujuan di notch"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노치에 승인 요청 표시"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar solicitações de aprovação no notch"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать запросы подтверждения в notch"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在刘海中显示审批请求"
          }
        }
      }
    },
    "plugin.hermes.approvals.enabled": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر طلبات الموافقة في الشريط. إذا لم تكن Coucou تعمل، يعود Hermes إلى طرفيته الخاصة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নচে অনুমোদন অনুরোধ দেখানো হয়। Coucou না চললে Hermes তার নিজের প্রম্পটে ফলব্যাক করে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approval requests appear in the notch. If Coucou is not running, Hermes falls back to its own prompt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las solicitudes de aprobación aparecen en el notch. Si Coucou no está en ejecución, Hermes usa su propio prompt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les demandes d'approbation s'affichent dans le notch. Si Coucou ne tourne pas, Hermes utilise son propre prompt."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नॉच में अनुमोदन अनुरोध दिखाए जाते हैं। यदि Coucou नहीं चल रहा तो Hermes अपने प्रॉम्प्ट पर वापस जाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Permintaan persetujuan muncul di notch. Jika Coucou tidak berjalan, Hermes menggunakan promptnya sendiri."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "승인 요청이 노치에 나타납니다. Coucou가 실행 중이 아니면 Hermes가 자체 프롬프트를 띄웁니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Solicitações de aprovação aparecem no notch. Se Coucou não estiver em execução, Hermes usa seu próprio prompt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запросы подтверждения отображаются в notch. Если Coucou не запущен, Hermes использует собственный prompt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "审批请求显示在刘海中。若 Coucou 未运行，Hermes 将回退到其自己的提示。"
          }
        }
      }
    },
    "plugin.hermes.approvals.disabled": {
