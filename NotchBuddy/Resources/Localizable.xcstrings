    "integrations.github.token-hint": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رمز كلاسيكي بصلاحية repo، أو رمز دقيق بصلاحية قراءة لـ Pull requests وحالات الإيداع والـ Actions."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "repo স্কোপ সহ ক্লাসিক টোকেন, অথবা Pull requests, Commit statuses এবং Actions-এ পড়ার অ্যাক্সেস সহ ফাইন-গ্রেইনড টোকেন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Classic token with repo scope, or fine-grained with read access to Pull requests, commit statuses, and Actions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Token clásico con scope repo, o de grano fino con acceso de lectura a Pull requests, Commit statuses y Actions."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Token classique avec le scope repo, ou à portée fine avec accès en lecture aux Pull requests, statuts de commit et Actions."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "repo स्कोप के साथ क्लासिक टोकन, या Pull requests, Commit statuses और Actions में रीड एक्सेस के साथ फाइन-ग्रेन्ड टोकन।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Token klasik dengan scope repo, atau token fine-grained dengan akses baca ke Pull requests, Commit statuses, dan Actions."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "repo 범위의 클래식 토큰, 또는 Pull requests·commit statuses·Actions 읽기 권한이 있는 세분화된 토큰."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Token clássico com escopo repo, ou fine-grained com acesso de leitura a Pull requests, Commit statuses e Actions."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Классический токен с правом repo или гранулярный с доступом на чтение к Pull requests, Commit statuses и Actions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "具有 repo 权限的经典令牌，或具有 Pull requests、Commit statuses 和 Actions 读取权限的细粒度令牌。"
          }
        }
      }
    },
