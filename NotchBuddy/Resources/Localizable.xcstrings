    "macOS asks for permission the first time Coucou shows a notification.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يطلب macOS الإذن في أول مرة يعرض فيها Coucou إشعارًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Coucou প্রথমবার বিজ্ঞপ্তি দেখালে macOS অনুমতি চায়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS asks for permission the first time Coucou shows a notification."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS pide permiso la primera vez que Coucou muestra una notificación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS demande l’autorisation la première fois que Coucou affiche une notification."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब Coucou पहली बार सूचना दिखाता है, तब macOS अनुमति माँगता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS meminta izin saat Coucou pertama kali menampilkan notifikasi."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Coucou가 처음 알림을 띄울 때 macOS가 권한을 묻습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS pede permissão na primeira vez que o Coucou mostra uma notificação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS запросит разрешение, когда Coucou впервые покажет уведомление."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Coucou 首次显示通知时，macOS 会请求权限。"
          }
        }
      }
    },
