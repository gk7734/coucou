{"_meta": {"description": "Load test: 3 Claude Code sessions on 3 hosts, ~10 events/s in total for 60 s (Read, Grep, Edit with diff, Bash). Use -q.", "parallel": 3, "parallel_hosts": ["com.jetbrains.WebStorm", "dev.zed.Zed", "com.jetbrains.pycharm"], "stagger": 0.1, "relay": {"bundle_id": "${HOST}", "term_program": ""}}}
# For CPU / main-thread measurements before and after an optimisation. Each worker (one session, one host)
# sends an event every 0.3 s on an absolute schedule; workers start 0.1 s apart, so the app sees one event
# every ~0.1 s: 600 events in ~60 s. The summary prints the rate actually achieved. --speed 3 = ~30 events/s.
# --parallel N runs N sessions (hosts cycle through parallel_hosts); --host X puts them all on X.
{"hook_event_name": "SessionStart", "session_id": "burst-${WORKER}-${RUN}", "cwd": "${ROOT}/burst-${WORKER}", "source": "startup"}
{"_delay": 0.3, "hook_event_name": "UserPromptSubmit", "session_id": "burst-${WORKER}-${RUN}", "cwd": "${ROOT}/burst-${WORKER}", "prompt": "Refactor the module, one small step at a time"}
{"_delay": 0.3, "_repeat": 197, "session_id": "burst-${WORKER}-${RUN}", "cwd": "${ROOT}/burst-${WORKER}", "_cycle": [{"hook_event_name": "PreToolUse", "tool_name": "Read", "tool_input": {"file_path": "${ROOT}/burst-${WORKER}/src/module_${C}.ts"}}, {"hook_event_name": "PostToolUse", "tool_name": "Read", "tool_input": {"file_path": "${ROOT}/burst-${WORKER}/src/module_${C}.ts"}}, {"hook_event_name": "PreToolUse", "tool_name": "Grep", "tool_input": {"pattern": "handler${C}", "path": "${ROOT}/burst-${WORKER}"}}, {"hook_event_name": "PostToolUse", "tool_name": "Grep", "tool_input": {"pattern": "handler${C}", "path": "${ROOT}/burst-${WORKER}"}}, {"hook_event_name": "PreToolUse", "tool_name": "Edit", "tool_input": {"file_path": "${ROOT}/burst-${WORKER}/src/module_${C}.ts", "old_string": "const step = ${C}\nconst label = 'old'\nexport default step\n", "new_string": "const step = ${C} + 1\nconst label = 'new'\nconst checked = true\nexport default step\n"}}, {"hook_event_name": "PostToolUse", "tool_name": "Edit", "tool_input": {"file_path": "${ROOT}/burst-${WORKER}/src/module_${C}.ts", "old_string": "const step = ${C}\nconst label = 'old'\nexport default step\n", "new_string": "const step = ${C} + 1\nconst label = 'new'\nconst checked = true\nexport default step\n"}}, {"hook_event_name": "PreToolUse", "tool_name": "Bash", "tool_input": {"command": "npm run lint -- src/module_${C}.ts"}}, {"hook_event_name": "PostToolUse", "tool_name": "Bash", "tool_input": {"command": "npm run lint -- src/module_${C}.ts"}}]}
{"_delay": 0.3, "hook_event_name": "Stop", "session_id": "burst-${WORKER}-${RUN}", "cwd": "${ROOT}/burst-${WORKER}", "last_assistant_message": "Burst finished."}
